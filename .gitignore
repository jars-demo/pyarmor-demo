# Repo-wide ignores. Website-only rules live in web/.gitignore.

# Secrets and local settings: only the example is shared
.env
.env.*
!.env.example

# Build output: protected builds, wheels, PyInstaller bundles. Always regenerated, never committed
# (they only run on the platform and Python version that built them).
build/
dist/
*.spec
pyarmor.debug.log
.pyarmor/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
