# Settings for the Secret Analytics API. Copy to .env to change them; every value has a default.
# Nothing here is secret, and nothing secret should ever go here or into the code: see
# workshop/12-best-practices.md for where secrets belong.

# Address and port the API listens on. In Docker the API listens on 0.0.0.0:8300 inside the
# container; docker-compose.yml publishes it on 127.0.0.1 only.
PYARMOR_DEMO_HOST=127.0.0.1
PYARMOR_DEMO_PORT=8300

# debug, info, warning or error
PYARMOR_DEMO_LOG_LEVEL=info

# Shown by GET /api/info: development, test or production
PYARMOR_DEMO_ENV=development
